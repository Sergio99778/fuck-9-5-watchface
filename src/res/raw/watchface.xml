                            <Text align="CENTER" maxLines="1">
                              <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05">LIBRE</Font>
                            </Text>
                          </PartText>
                        </Default>
                      </Condition>
                    </Default>
                  </Condition>
                </Default>
              </Condition>
            </Default>
