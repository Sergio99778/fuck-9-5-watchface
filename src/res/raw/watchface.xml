    <Group name="countdown" x="75" y="346" width="300" height="30">
      <Variant mode="AMBIENT" target="alpha" duration="0" value="150"/>
      <Condition>
        <Expressions>
          <Expression name="cd_weekend"><![CDATA[([DAY_OF_WEEK] == 1) || ([DAY_OF_WEEK] == 7) || (([DAY_OF_WEEK] == 6) && ([HOUR_0_23] >= 17))]]></Expression>
        </Expressions>
        <Compare expression="cd_weekend">
          <PartText name="countdown_weekend" x="0" y="0" width="300" height="30">
            <Text align="CENTER" maxLines="1">
              <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05">FIN DE SEMANA</Font>
            </Text>
          </PartText>
        </Compare>
        <Default>
          <Condition>
            <Expressions>
              <Expression name="cd_before9_h"><![CDATA[([HOUR_0_23] * 60 + [MINUTE]) <= 480]]></Expression>
            </Expressions>
            <Compare expression="cd_before9_h">
              <PartText name="countdown_before9_h" x="0" y="0" width="300" height="30">
                <Text align="CENTER" maxLines="1">
                  <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05"><Template>ENTRAS EN %sH %sM<Parameter expression="round(floor((540 - ([HOUR_0_23] * 60 + [MINUTE])) / 60))"/><Parameter expression="(540 - ([HOUR_0_23] * 60 + [MINUTE])) % 60"/></Template></Font>
                </Text>
              </PartText>
            </Compare>
            <Default>
              <Condition>
                <Expressions>
                  <Expression name="cd_before9_m"><![CDATA[[HOUR_0_23] < 9]]></Expression>
                </Expressions>
                <Compare expression="cd_before9_m">
                  <PartText name="countdown_before9_m" x="0" y="0" width="300" height="30">
                    <Text align="CENTER" maxLines="1">
                      <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05"><Template>ENTRAS EN %sM<Parameter expression="(540 - ([HOUR_0_23] * 60 + [MINUTE]))"/></Template></Font>
                    </Text>
                  </PartText>
                </Compare>
                <Default>
                  <Condition>
                    <Expressions>
                      <Expression name="cd_work_h"><![CDATA[([HOUR_0_23] * 60 + [MINUTE]) <= 960]]></Expression>
                    </Expressions>
                    <Compare expression="cd_work_h">
                      <PartText name="countdown_work_h" x="0" y="0" width="300" height="30">
                        <Text align="CENTER" maxLines="1">
                          <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05"><Template>FALTAN %sH %sM<Parameter expression="round(floor((1020 - ([HOUR_0_23] * 60 + [MINUTE])) / 60))"/><Parameter expression="(1020 - ([HOUR_0_23] * 60 + [MINUTE])) % 60"/></Template></Font>
                        </Text>
                      </PartText>
                    </Compare>
                    <Default>
                      <Condition>
                        <Expressions>
                          <Expression name="cd_work_m"><![CDATA[[HOUR_0_23] < 17]]></Expression>
                        </Expressions>
                        <Compare expression="cd_work_m">
                          <PartText name="countdown_work_m" x="0" y="0" width="300" height="30">
                            <Text align="CENTER" maxLines="1">
                              <Font family="n95_label" size="21" color="#FFEDEDED" letterSpacing="0.05"><Template>FALTAN %sM<Parameter expression="(1020 - ([HOUR_0_23] * 60 + [MINUTE]))"/></Template></Font>
                            </Text>
                          </PartText>
                        </Compare>
                        <Default>
